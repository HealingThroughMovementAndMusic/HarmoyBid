VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Cloudflare Turnstile site key for the public /sign/:quoteId
# page's bot-protection widget. Public value (safe client-side, same as
# the anon key above). Leave unset and the page works exactly as before
# (widget simply doesn't render, sign-quote skips verification) — see
# CLAUDE.md → "Cloudflare Turnstile" for the activation steps once a real
# domain + Turnstile widget exist.
VITE_TURNSTILE_SITE_KEY=

# That's it for client-side env vars — Google Calendar/Drive and the signing
# notification email are configured entirely server-side as Supabase Edge
# Function secrets (GOOGLE_SERVICE_ACCOUNT_KEY, GOOGLE_CALENDAR_ID,
# RESEND_API_KEY), set via the Supabase Dashboard's Edge Functions → Secrets
# Management page, never as a VITE_-prefixed var. See CLAUDE.md → "Google
# Calendar & Drive setup" and "Signing notification email".
