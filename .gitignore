# Claude Code tooling — session/agent config, not application source.
# Note: this does NOT retroactively untrack files already committed under
# these paths (git-ignore only affects new/untracked files) — it only
# guards against a future broad `git add -A`/`git add .` accidentally
# staging new additions here.
.claude/
.agents/
.mcp.json
skills-lock.json

# Claude Code audit backups (scratch, not project content)
.claude-audit-backup-*/

# Generated audit output (regenerated by `npm run audit`, not source)
scripts/audit-report.json

# Browser/dev-tool session artifacts (screenshots, console/page dumps)
.playwright-mcp/
.playwright/

# Python bytecode cache
__pycache__/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env.local
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
